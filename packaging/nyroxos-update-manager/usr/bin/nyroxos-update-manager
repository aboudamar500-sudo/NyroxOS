#!/bin/sh
set -eu
ENGINE=/usr/bin/nyroxos-update-engine
if ! command -v zenity >/dev/null 2>&1; then
    exec "$ENGINE" --check
fi

if zenity --question --title="NyroxOS ISO" --text="هل تريد تنزيل أحدث نسخة من NyroxOS والتحقق منها؟"; then
    log=$(mktemp)
    if "$ENGINE" --iso-download >"$log" 2>&1; then
        zenity --info --title="اكتمل تنزيل NyroxOS" --text="$(cat "$log")"
    else
        zenity --error --title="فشل تنزيل ISO" --text="$(cat "$log")"
    fi
    rm -f "$log"
fi
if ! result=$("$ENGINE" --check 2>&1); then
    zenity --error --title="NyroxOS Update Manager" --text="$result"
    exit 1
fi
zenity --info --title="NyroxOS Update Manager" --text="حالة التحديث:\n\n$result"
if zenity --question --title="NyroxOS Update Manager" --text="هل تريد تنزيل التحديث والتحقق منه وتجهيزه للتطبيق عند إعادة التشغيل؟"; then
    log=$(mktemp)
    if pkexec "$ENGINE" --stage >"$log" 2>&1; then
        zenity --info --title="NyroxOS Update Manager" --text="$(cat "$log")"
        if zenity --question --title="إعادة التشغيل" --text="تم تجهيز التحديث. هل تريد إعادة تشغيل النظام لتطبيقه الآن؟"; then
            pkexec systemctl reboot
        fi
    else
        zenity --error --title="فشل التحديث" --text="$(cat "$log")"
        rm -f "$log"
        exit 1
    fi
    rm -f "$log"
fi
