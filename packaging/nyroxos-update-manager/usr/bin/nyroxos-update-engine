#!/usr/bin/env python3
import os
import sys
import json
import base64
import hashlib
import shutil
import tarfile
import subprocess
import urllib.request
from pathlib import Path
from cryptography.hazmat.primitives import serialization
from cryptography.exceptions import InvalidSignature

REPO = "aboudamar500-sudo/NyroxOS"
API = f"https://api.github.com/repos/{REPO}/releases/latest"
KEY = Path("/usr/share/nyroxos/keys/update-ed25519-public.pem")
BASE = Path("/var/lib/nyroxos-update")
PENDING = BASE / "pending"
WORK = BASE / "work"
MAX_MANIFEST = 1024 * 1024
MAX_DOWNLOAD = 8 * 1024**3

CONFIG = Path("/etc/nyroxos/update.conf")
if CONFIG.exists():
    for line in CONFIG.read_text().splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            name, value = line.split("=", 1)
            globals()[name.strip()] = value.strip().strip("\"")
    KEY = Path(KEY)

def fail(message):
    raise RuntimeError(message)

def request(url, limit):
    req = urllib.request.Request(url, headers={
        "User-Agent": "NyroxOS-Update-Manager/2.0",
        "Accept": "application/vnd.github+json"
    })
    with urllib.request.urlopen(req, timeout=60) as response:
        data = response.read(limit + 1)
    if len(data) > limit:
        fail("حجم الملف تجاوز الحد المسموح.")
    return data

def download(url, target):
    req = urllib.request.Request(url, headers={
        "User-Agent": "NyroxOS-Update-Manager/2.0"
    })
    total = 0
    with urllib.request.urlopen(req, timeout=120) as response:
        with target.open("wb") as output:
            while True:
                block = response.read(1024 * 1024)
                if not block:
                    break
                total += len(block)
                if total > MAX_DOWNLOAD:
                    fail("حجم التنزيل أكبر من الحد المسموح.")
                output.write(block)
    if total == 0:
        fail("الملف الذي تم تنزيله فارغ.")

def sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()

def verify_manifest(raw, signature):
    if not KEY.is_file():
        fail("مفتاح التحقق غير موجود.")
    public_key = serialization.load_pem_public_key(KEY.read_bytes())
    try:
        public_key.verify(signature, raw)
    except InvalidSignature:
        fail("التوقيع الرقمي غير صحيح؛ رُفض التحديث.")
    try:
        manifest = json.loads(raw)
    except Exception:
        fail("ملف manifest غير صالح.")
    if not isinstance(manifest, dict):
        fail("بنية manifest غير صالحة.")
    return manifest

def get_release():
    release = json.loads(request(API, 2 * 1024 * 1024))
    if release.get("draft") or release.get("prerelease"):
        fail("هذا الإصدار غير معتمد.")
    assets = {
        item["name"]: item
        for item in release.get("assets", [])
        if isinstance(item.get("name"), str)
    }
    if "manifest.json" not in assets or "manifest.json.sig" not in assets:
        fail("الإصدار لا يحتوي البيان وتوقيعه.")
    raw = request(
        assets["manifest.json"]["browser_download_url"],
        MAX_MANIFEST
    )
    encoded = request(
        assets["manifest.json.sig"]["browser_download_url"],
        4096
    ).strip()
    try:
        signature = base64.b64decode(encoded, validate=True)
    except Exception:
        fail("ترميز التوقيع غير صالح.")
    manifest = verify_manifest(raw, signature)
    return release, manifest, raw, signature, assets

def checked_packages(manifest):
    packages = manifest.get("packages")
    if not isinstance(packages, list) or not packages:
        fail("قائمة الحزم غير صالحة.")
    result = {}
    for item in packages:
        if not isinstance(item, dict):
            fail("بيانات إحدى الحزم غير صالحة.")
        name = item.get("name", "")
        digest = item.get("sha256", "")
        if (not isinstance(name, str)
                or not name.endswith(".deb")
                or Path(name).name != name
                or not isinstance(digest, str)
                or len(digest) != 64
                or any(c not in "0123456789abcdefABCDEF" for c in digest)):
            fail("اسم حزمة أو بصمة SHA-256 غير صالحة.")
        if name in result:
            fail("اسم حزمة مكرر في البيان.")
        result[name] = digest.lower()
    return result

def stage(release, manifest, raw, sig, assets):
    if os.geteuid() != 0:
        fail("يلزم تشغيل تجهيز التحديث بصلاحيات المسؤول.")
    if PENDING.exists():
        fail("يوجد تحديث مجهز مسبقًا.")
    packages = checked_packages(manifest)
    WORK.mkdir(parents=True, exist_ok=True)
    temp = WORK / "pending-new"
    temp.mkdir(exist_ok=False)
    try:
        (temp / "packages").mkdir()
        for name, digest in packages.items():
            asset = assets.get(name)
            if not asset:
                fail("ملف الحزمة غير موجود: " + name)
            target = temp / "packages" / name
            download(asset["browser_download_url"], target)
            if sha256(target) != digest:
                fail("فشل التحقق من الحزمة: " + name)
        (temp / "manifest.json").write_bytes(raw)
        (temp / "manifest.json.sig").write_bytes(sig)
        PENDING.parent.mkdir(parents=True, exist_ok=True)
        temp.rename(PENDING)
        print("تم التحقق من التحديث وتجهيزه.")
    except Exception:
        print("فشل التجهيز؛ ملفات العمل محفوظة في:", temp)
        raise


def iso_download():
    release, _, _, _, assets = get_release()
    if "iso-manifest.json" not in assets or "iso-manifest.json.sig" not in assets:
        fail("بيان ISO الموقّع غير موجود.")
    raw = request(assets["iso-manifest.json"]["browser_download_url"], MAX_MANIFEST)
    encoded = request(assets["iso-manifest.json.sig"]["browser_download_url"], 4096)
    manifest = verify_manifest(raw, base64.b64decode(encoded))
    size = manifest.get("final_size")
    digest = manifest.get("final_sha256")
    if not isinstance(size, int) or not 0 < size <= MAX_DOWNLOAD:
        fail("حجم ISO غير صالح.")
    if not isinstance(digest, str) or len(digest) != 64 or any(c not in "0123456789abcdef" for c in digest.lower()):
        fail("بصمة ISO غير صالحة.")
    downloads = Path.home() / "Downloads"
    downloads.mkdir(parents=True, exist_ok=True)
    tag = "".join(c if c.isalnum() or c in "-_" else "_" for c in release["tag_name"])
    target = downloads / ("NyroxOS-" + tag + ".iso")
    if target.exists():
        fail("ملف ISO موجود مسبقًا: " + str(target))
    work = downloads / (".nyroxos-iso-" + tag)
    work.mkdir(exist_ok=True)
    assembled = work / "assembled.iso"
    try:
        kind = manifest.get("type")
        if kind == "parts":
            parts = manifest.get("parts")
            if not isinstance(parts, list) or not parts:
                fail("قائمة أجزاء ISO غير صالحة.")
            parts = sorted(parts, key=lambda x: x["index"])
            if [x["index"] for x in parts] != list(range(len(parts))):
                fail("ترتيب أجزاء ISO غير مكتمل.")
            with assembled.open("wb") as out:
                for part in parts:
                    name = part["name"]
                    if Path(name).name != name or name not in assets:
                        fail("ملف جزء غير صالح: " + str(name))
                    item = work / name
                    download(assets[name]["browser_download_url"], item)
                    if item.stat().st_size != part["size"] or sha256(item) != part["sha256"]:
                        fail("فشل التحقق من الجزء: " + name)
                    with item.open("rb") as src:
                        shutil.copyfileobj(src, out)
        elif kind == "single":
            name = manifest["name"]
            if Path(name).name != name or name not in assets:
                fail("ملف ISO غير موجود.")
            download(assets[name]["browser_download_url"], assembled)
            if assembled.stat().st_size != manifest["size"] or sha256(assembled) != manifest["sha256"]:
                fail("فشل التحقق من ملف ISO.")
        else:
            fail("نوع بيان ISO غير مدعوم.")
        if assembled.stat().st_size != size or sha256(assembled) != digest:
            fail("فشل التحقق النهائي من ISO.")
        assembled.replace(target)
        shutil.rmtree(work)
        print("تم تنزيل ISO والتحقق منه:")
        print(target)
    except Exception:
        print("فشل التنزيل؛ ملفات العمل محفوظة في:", work)
        raise

def apply():
    if os.geteuid() != 0:
        fail("يلزم صلاحيات المسؤول.")
    if not PENDING.is_dir():
        fail("لا يوجد تحديث مجهز.")
    raw = (PENDING / "manifest.json").read_bytes()
    sig = (PENDING / "manifest.json.sig").read_bytes()
    manifest = verify_manifest(raw, sig)
    packages = checked_packages(manifest)
    files = []
    for name, digest in packages.items():
        path = PENDING / "packages" / name
        if not path.is_file() or sha256(path) != digest:
            fail("فشل التحقق من الحزمة: " + name)
        files.append(str(path))
    log = BASE / "apply.log"
    with log.open("a") as output:
        subprocess.run(
            ["dpkg", "-i", *files],
            stdout=output,
            stderr=subprocess.STDOUT,
            check=True
        )
    shutil.rmtree(PENDING)
    print("اكتمل التحديث بنجاح.")

def main():
    if len(sys.argv) != 2:
        fail("استخدم --check أو --stage أو --apply أو --iso-download.")
    action = sys.argv[1]
    if action == "--iso-download":
        iso_download()
        return
    if action == "--apply":
        apply()
        return
    if action not in ("--check", "--stage"):
        fail("أمر غير معروف.")
    release, manifest, raw, sig, assets = get_release()
    if action == "--check":
        checked_packages(manifest)
        print("التوقيع صحيح.")
        print("الإصدار:", manifest.get("version"))
    else:
        stage(release, manifest, raw, sig, assets)

if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print("ERROR:", error, file=sys.stderr)
        sys.exit(1)
