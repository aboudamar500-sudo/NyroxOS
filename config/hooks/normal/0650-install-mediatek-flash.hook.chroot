#!/bin/sh
set -eu

REV=ecbd68ccff7a53b12b3b14d10ae28c6f4ed999f3
SRC=/opt/mediatek_flash-src

apt-get update
apt-get install -y git make gcc pkg-config libusb-1.0-0-dev

git clone https://github.com/ilyakurdyukov/mediatek_flash.git "$SRC"
git -C "$SRC" checkout "$REV"
make -C "$SRC"

install -m 0755 "$SRC/mtk_dump" /usr/local/bin/mtk_dump
install -d /etc/udev/rules.d

cat > /etc/udev/rules.d/80-nyroxos-mediatek.rules <<'RULES'
SUBSYSTEMS=="usb", ATTRS{idVendor}=="0e8d", ATTRS{idProduct}=="0003", MODE="0660", GROUP="plugdev", TAG+="uaccess"
RULES

test -x /usr/local/bin/mtk_dump

apt-get clean
rm -rf /var/lib/apt/lists/*
