Window.SetBackgroundTopColor(0.015, 0.025, 0.02);
Window.SetBackgroundBottomColor(0.005, 0.01, 0.008);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetPosition(
    Window.GetWidth() / 2 - logo_image.GetWidth() / 2,
    Window.GetHeight() / 2 - logo_image.GetHeight() / 2,
    100
);
